# npm run setup creates .env, an absolute database URL and a random session encryption key.
HOST=127.0.0.1
PORT=3100
DATABASE_URL=file:./data/bidcenter.db
DATA_DIR=./data
SESSION_KEY=
LOGIN_METHOD=sms
LOGIN_PHONE=
# Pin the saved session to the intended member account (site username).
BIDCENTER_ACCOUNT=
LOGIN_USERNAME=
LOGIN_PASSWORD=
# chrome-manual: operator logs into normal Chrome; observe via local CDP and sync automatically.
# playwright: managed forms with SMS input through management page.
LOGIN_BROWSER_MODE=chrome-manual
CHROME_EXECUTABLE=
CHROME_DEBUG_PORT=9227
# Blank uses Playwright Chromium; chrome uses installed Google Chrome.
BROWSER_CHANNEL=
# Login/challenge windows are always visible; the legacy setting is ignored.
BROWSER_HEADLESS=false
# Defaults to one combined search; 'separate' submits each keyword individually.
SEARCH_MODE=combined
SEARCH_KEYWORDS=昇腾,鲲鹏,服务器,工作站
# Sent verbatim as the site's keyword expression. No local AND/OR rewriting.
SEARCH_COMBINED_QUERY=昇腾、鲲鹏、服务器、工作站
SEARCH_TAG=0
LOOKBACK_DAYS=7
# Shared across all queries in one task; hard maximum is 15.
MAX_PAGES_PER_RUN=15
# Shared serial queue, with a short pause after each response. Both intervals may be 0.
REQUEST_MIN_INTERVAL_MS=1500
REQUEST_MAX_INTERVAL_MS=3000
# 0 disables batch breaks. Set a positive batch size and break range to enable them.
REQUEST_BATCH_SIZE=0
REQUEST_BREAK_MIN_MS=0
REQUEST_BREAK_MAX_MS=0
# HTTP 429 fallback cooldown; a longer Retry-After always wins.
# Human verification alone adds no local cooldown, but still pauses collection.
RATE_LIMIT_COOLDOWN_MS=1800000
REQUEST_RETRY_BASE_MS=60000
REQUEST_TIMEOUT_MS=30000
DETAIL_REFRESH_HOURS=24
SCHEDULE_ENABLED=true
RUN_ON_STARTUP=false
# Only enable when the operator has configured/authorized the destination.
NOTIFICATION_WEBHOOK_URL=
